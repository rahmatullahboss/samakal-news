{
	"compatibility_date": "2026-03-14",
	"compatibility_flags": ["nodejs_compat"],
	"name": "samakal-news",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "samakal-news-db",
			"database_id": "4a9b5f73-1eb2-4f81-9eea-708e50fbbd8b"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "samakal-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "2b4f3eb2ae0d4f09b2ab3bf7fafb9801"
		},
		{
			"binding": "CACHE",
			"id": "8a3791dcd4eb447b93ddae1fdcc9a503"
		}
	]
}