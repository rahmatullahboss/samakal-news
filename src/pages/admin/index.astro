---
// src/pages/admin/index.astro — Admin Dashboard
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
export const prerender = false;

const DB = (env as any).DB;
const user = (Astro.locals as any).user;

// Stats
const totalArticles = await DB.prepare("SELECT COUNT(*) as n FROM articles").first<{n:number}>();
const publishedArticles = await DB.prepare("SELECT COUNT(*) as n FROM articles WHERE status='published'").first<{n:number}>();
const draftArticles = await DB.prepare("SELECT COUNT(*) as n FROM articles WHERE status='draft'").first<{n:number}>();
const totalCategories = await DB.prepare("SELECT COUNT(*) as n FROM categories").first<{n:number}>();

// Recent articles
const { results: recentArticles } = await DB.prepare(`
  SELECT a.id, a.title, a.slug, a.status, a.published_at, a.view_count, c.name AS cat
  FROM articles a LEFT JOIN categories c ON a.category_id = c.id
  ORDER BY a.created_at DESC LIMIT 8
`).all<any>();
---
<AdminLayout title="ড্যাশবোর্ড | সমকাল Admin" activeNav="dashboard">
  <div class="admin-page">
    <div class="admin-page-header">
      <h1 class="admin-page-title">ড্যাশবোর্ড</h1>
      <a href="/admin/articles/new" class="btn-primary">+ নতুন সংবাদ</a>
    </div>

    <!-- Stat cards -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-card__num">{totalArticles?.n ?? 0}</div>
        <div class="stat-card__label">মোট সংবাদ</div>
      </div>
      <div class="stat-card stat-card--green">
        <div class="stat-card__num">{publishedArticles?.n ?? 0}</div>
        <div class="stat-card__label">প্রকাশিত</div>
      </div>
      <div class="stat-card stat-card--yellow">
        <div class="stat-card__num">{draftArticles?.n ?? 0}</div>
        <div class="stat-card__label">ড্রাফট</div>
      </div>
      <div class="stat-card stat-card--blue">
        <div class="stat-card__num">{totalCategories?.n ?? 0}</div>
        <div class="stat-card__label">বিভাগ</div>
      </div>
    </div>

    <!-- Recent articles table -->
    <div class="admin-card">
      <div class="admin-card__header">
        <h2 class="admin-card__title">সাম্প্রতিক সংবাদ</h2>
        <a href="/admin/articles">সব দেখুন →</a>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>শিরোনাম</th>
            <th>বিভাগ</th>
            <th>স্ট্যাটাস</th>
            <th>ভিউ</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          {recentArticles.map((a: any) => (
            <tr>
              <td class="td-title">
                <a href={`/admin/articles/${a.id}/edit`}>{a.title}</a>
              </td>
              <td>{a.cat ?? '—'}</td>
              <td>
                <span class:list={['status-badge', `status-badge--${a.status}`]}>
                  {a.status === 'published' ? 'প্রকাশিত' : a.status === 'draft' ? 'ড্রাফট' : a.status}
                </span>
              </td>
              <td>{a.view_count ?? 0}</td>
              <td>
                <div class="td-actions">
                  <a href={`/admin/articles/${a.id}/edit`} class="action-btn">সম্পাদনা</a>
                  <a href={`/${a.slug}`} target="_blank" class="action-btn action-btn--ghost">দেখুন</a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
.admin-page { padding: 32px; }
.admin-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
.admin-page-title { font-size: 24px; font-weight: 700; color: #111; }
.btn-primary { background: #F9B200; color: #000; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
.btn-primary:hover { opacity: 0.9; }

.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px; }
.stat-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 12px; padding: 20px 24px; }
.stat-card--green { border-left: 3px solid #22c55e; }
.stat-card--yellow { border-left: 3px solid #F9B200; }
.stat-card--blue { border-left: 3px solid #3b82f6; }
.stat-card__num { font-size: 32px; font-weight: 800; color: #111; line-height: 1; }
.stat-card__label { font-size: 13px; color: #6B7280; margin-top: 4px; }

.admin-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 12px; overflow: hidden; }
.admin-card__header { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid #E5E7EB; }
.admin-card__title { font-size: 15px; font-weight: 600; }
.admin-card__header a { font-size: 13px; color: #6B7280; text-decoration: none; }
.admin-card__header a:hover { color: #F9B200; }

.admin-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.admin-table th { padding: 10px 16px; text-align: left; background: #F9FAFB; color: #6B7280; font-weight: 500; font-size: 12px; border-bottom: 1px solid #E5E7EB; }
.admin-table td { padding: 12px 16px; border-bottom: 1px solid #F3F4F6; vertical-align: middle; }
.admin-table tr:last-child td { border-bottom: none; }
.td-title a { color: #111; font-weight: 500; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.td-title a:hover { color: #F9B200; }

.status-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
.status-badge--published { background: #dcfce7; color: #16a34a; }
.status-badge--draft { background: #FEF9C3; color: #854d0e; }
.status-badge--archived { background: #F3F4F6; color: #6B7280; }

.td-actions { display: flex; gap: 8px; }
.action-btn { font-size: 12px; padding: 4px 10px; border-radius: 6px; background: #F9B200; color: #000; font-weight: 500; text-decoration: none; transition: opacity 0.15s; }
.action-btn:hover { opacity: 0.8; }
.action-btn--ghost { background: #F3F4F6; color: #374151; }
</style>
