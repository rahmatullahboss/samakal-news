---
// src/pages/[slug].astro — Dynamic Article Detail Page
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { sanitizeHtml } from '../lib/sanitize';

export const prerender = false;

const { slug } = Astro.params;
const DB = (env as any).DB;
const CACHE = (env as any).CACHE;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');

// Fetch article from D1
const article = await DB.prepare(`
  SELECT
    a.id, a.title, a.slug, a.excerpt, a.content, a.featured_image,
    a.is_breaking, a.published_at,
    c.name AS category,  c.slug AS category_slug,
    au.name AS author,   au.slug AS author_slug
  FROM articles a
  LEFT JOIN categories c  ON a.category_id = c.id
  LEFT JOIN authors au    ON a.author_id   = au.id
  WHERE a.slug = ? AND a.status = 'published'
`).bind(slug).first<any>();

if (!article) return Astro.redirect('/404');

// Fix #7: build derived URLs here (not in template)
const categoryHref = article.category_slug ? `/category/${article.category_slug}` : '/';
const authorHref   = article.author_slug   ? `/author/${article.author_slug}`   : '#';

// Fix #1: sanitize HTML to prevent XSS from contenteditable editor
const safeContent = sanitizeHtml(article.content ?? '');

// Fix #9: IP-based view dedup (1h window via CACHE KV)
const ip = Astro.request.headers.get('CF-Connecting-IP') ?? 'unknown';
const viewKey = `view:${article.id}:${ip}`;
const alreadyViewed = await CACHE?.get(viewKey).catch(() => null);
if (!alreadyViewed) {
  DB.prepare('UPDATE articles SET view_count = view_count + 1 WHERE id = ?').bind(article.id).run().catch(() => {});
  CACHE?.put(viewKey, '1', { expirationTtl: 3600 }).catch(() => {});
}

// Fetch related articles
const { results: relatedRows } = await DB.prepare(`
  SELECT a.title, a.slug, a.featured_image, c.name AS category, c.slug AS cat_slug
  FROM articles a
  LEFT JOIN categories c ON a.category_id = c.id
  WHERE a.status = 'published' AND a.slug != ? AND a.category_id = (
    SELECT category_id FROM articles WHERE slug = ?
  )
  ORDER BY a.published_at DESC LIMIT 4
`).bind(slug, slug).all<any>().catch(() => ({ results: [] }));

// Fetch article tags (graceful if table missing)
const { results: tagRows } = await DB.prepare(`
  SELECT t.name, t.slug FROM tags t
  JOIN article_tags at ON at.tag_id = t.id
  WHERE at.article_id = ?
`).bind(article.id).all<any>().catch(() => ({ results: [] }));

const related = (relatedRows ?? []).map((r: any) => ({
  title: r.title,
  href: `/${r.slug}`,
  image: r.featured_image,   // Fix #7: use featured_image (not image)
  category: r.category,
  categoryHref: `/category/${r.cat_slug}`,
}));

const tags = (tagRows ?? []).map((t: any) => ({ name: t.name, slug: t.slug }));

// Format date in Bangla
const banglaDigits = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
const toBangla = (n: number) => String(n).split('').map(d => banglaDigits[+d] ?? d).join('');
const banglaMonths = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
const dateObj = article.published_at ? new Date(article.published_at) : new Date();
const publishedAt = `${toBangla(dateObj.getDate())} ${banglaMonths[dateObj.getMonth()]} ${toBangla(dateObj.getFullYear())}`;
---

<BaseLayout
  title={`${article.title} | সমকাল`}
  description={article.excerpt}
  ogImage={article.featured_image}
>
  <Header />

  <main class="article-page">
    <div class="container">
      <div class="article-layout">

        <!-- Main article content -->
        <article class="article-main">
          <!-- Breadcrumb -->
          <nav class="breadcrumb" aria-label="ব্রেডক্রাম্ব">
            <a href="/">হোম</a>
            <span>›</span>
            <a href={categoryHref}>{article.category}</a>
          </nav>

          <!-- Category -->
          <a href={categoryHref} class="category-badge">{article.category}</a>

          <!-- Title -->
          <h1 class="article-title">{article.title}</h1>

          <!-- Excerpt -->
          <p class="article-lead">{article.excerpt}</p>

          <!-- Meta -->
          <div class="article-meta">
            <div class="article-meta__author">
              <span class="article-meta__label">লেখক:</span>
              <a href={authorHref} class="article-meta__author-name">{article.author}</a>
            </div>
            <div class="article-meta__divider" aria-hidden="true">|</div>
            <time class="article-meta__date">{publishedAt}</time>
            <div class="article-meta__share">
              <button class="share-btn" aria-label="ফেসবুকে শেয়ার">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </button>
              <button class="share-btn" aria-label="X-তে শেয়ার">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
            </div>
          </div>

          <!-- Featured Image -->
          {article.featured_image && (
            <figure class="article-figure">
              <img src={article.featured_image} alt={article.title} loading="eager" />
            </figure>
          )}

          <!-- Article body (Fix #1: sanitized HTML) -->
          <div class="article-body" set:html={safeContent} />

          <!-- Tags (Fix #7: use local `tags` variable, not article.tags) -->
          {tags.length > 0 && (
            <div class="article-tags">
              <span class="article-tags__label">ট্যাগ:</span>
              {tags.map((tag: any) => (
                <a href={`/tag/${tag.slug}`} class="article-tag">{tag.name}</a>
              ))}
            </div>
          )}

          <!-- Share footer -->
          <div class="article-share-footer">
            <span>এই সংবাদটি শেয়ার করুন:</span>
            <div class="share-buttons">
              <button class="share-btn share-btn--facebook">ফেসবুক</button>
              <button class="share-btn share-btn--x">X</button>
            </div>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="article-sidebar">
          <div class="ad-slot ad-slot-large" style="margin-bottom: var(--space-6);">বিজ্ঞাপন</div>

          <div class="sidebar-section">
            <div class="section-header" style="margin-bottom: var(--space-4);">
              <h2>সংশ্লিষ্ট খবর</h2>
            </div>
            <div class="sidebar-articles">
              {related.slice(0, 4).map(r => (
                <div class="sidebar-article-item">
                  <ArticleCard title={r.title} href={r.href} image={r.image} category={r.category} variant="small" />
                  <div class="divider" style="margin: var(--space-3) 0;" />
                </div>
              ))}
            </div>
          </div>
        </aside>
      </div>

      <!-- Related articles grid -->
      <section class="related-section">
        <div class="section-header">
          <h2>আরও পড়ুন</h2>
        </div>
        <div class="related-grid">
          {related.map(r => (
            <ArticleCard title={r.title} href={r.href} image={r.image} category={r.category} variant="medium" />
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
.article-page { padding: var(--space-6) 0 var(--space-10); }

.article-layout {
  display: grid;
  grid-template-columns: 1fr var(--sidebar-w);
  gap: var(--grid-gap);
  align-items: start;
  margin-bottom: var(--space-10);
}

/* Breadcrumb */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-meta);
  margin-bottom: var(--space-4);
}
.breadcrumb a { color: var(--color-link); }
.breadcrumb a:hover { text-decoration: underline; }

/* Title */
.article-title {
  font-family: var(--font-headline);
  font-size: var(--text-3xl);
  font-weight: 700;
  color: var(--color-text);
  line-height: var(--leading-tight);
  margin: var(--space-3) 0 var(--space-4);
}

/* Lead */
.article-lead {
  font-size: var(--text-lg);
  color: var(--color-text-secondary);
  line-height: var(--leading-normal);
  border-left: 4px solid var(--color-accent);
  padding-left: var(--space-4);
  margin-bottom: var(--space-5);
}

/* Meta */
.article-meta {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-3) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  margin-bottom: var(--space-5);
  font-size: var(--text-sm);
  flex-wrap: wrap;
}
.article-meta__label { color: var(--color-text-meta); }
.article-meta__author-name { color: var(--color-link); font-weight: 600; }
.article-meta__author-name:hover { text-decoration: underline; }
.article-meta__divider { color: var(--color-border-dark); }
.article-meta__date { color: var(--color-text-meta); }
.article-meta__share { margin-left: auto; display: flex; gap: var(--space-2); }

.share-btn {
  background: var(--color-accent);
  color: var(--color-text);
  border: none;
  padding: var(--space-1) var(--space-3);
  border-radius: var(--border-radius);
  cursor: pointer;
  font-size: var(--text-xs);
  display: flex;
  align-items: center;
  gap: var(--space-1);
  transition: background var(--transition);
  font-family: var(--font-body);
}
.share-btn:hover { background: var(--color-accent-dark); }

/* Featured image */
.article-figure {
  margin: 0 0 var(--space-6);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.article-figure img { width: 100%; max-height: 480px; object-fit: cover; }

/* Article body */
.article-body {
  font-size: var(--text-md);
  line-height: var(--leading-loose);
  color: var(--color-text-body);
}
.article-body p { margin-bottom: var(--space-5); }
.article-body h2, .article-body h3 {
  font-family: var(--font-headline);
  font-weight: 700;
  margin: var(--space-6) 0 var(--space-3);
  color: var(--color-text);
}
.article-body blockquote {
  border-left: 4px solid var(--color-accent);
  padding-left: var(--space-5);
  margin: var(--space-5) 0;
  color: var(--color-text-secondary);
  font-style: italic;
}

/* Tags */
.article-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-8);
  padding-top: var(--space-5);
  border-top: 1px solid var(--color-border);
}
.article-tags__label { font-size: var(--text-sm); color: var(--color-text-meta); }
.article-tag {
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  padding: var(--space-1) var(--space-3);
  border-radius: 20px;
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  transition: all var(--transition);
}
.article-tag:hover { background: var(--color-accent); border-color: var(--color-accent); color: #000; }

/* Share footer */
.article-share-footer {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-5);
  padding: var(--space-4);
  background: var(--color-bg-alt);
  border-radius: var(--border-radius);
  font-size: var(--text-sm);
}
.share-buttons { display: flex; gap: var(--space-2); }
.share-btn--facebook { background: #1877F2; color: white; }
.share-btn--facebook:hover { background: #0e6adf; }
.share-btn--x { background: #000; color: white; }
.share-btn--x:hover { background: #333; }

/* Sidebar */
.article-sidebar { position: sticky; top: 60px; }
.sidebar-section {}
.sidebar-article-item:last-child .divider { display: none; }

/* Related grid */
.related-section { padding-top: var(--space-8); border-top: 2px solid var(--color-border); }
.related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--grid-gap);
}

@media (max-width: 960px) {
  .article-layout { grid-template-columns: 1fr; }
  .article-sidebar { display: none; }
  .article-title { font-size: var(--text-2xl); }
  .related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .article-title { font-size: var(--text-xl); }
  .related-grid { grid-template-columns: 1fr 1fr; }
  .article-meta { gap: var(--space-2); }
}
</style>
