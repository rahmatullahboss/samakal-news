<BaseLayout title="সমকাল | সর্বশেষ অনলাইন বাংলা সংবাদ">
  <Header />
  <BreakingTicker items={breakingNews} />

  <!-- Top banner ad -->
  <div class="container" style="padding-top: var(--space-3); padding-bottom: var(--space-3);">
    <div class="ad-slot ad-slot-banner" style="height: 90px; margin: 0 auto;">বিজ্ঞাপন</div>
  </div>

  <main>
    <!-- Hero / নির্বাচিত section -->
    <HeroSection featured={heroFeatured} secondary={heroSecondary} latest={heroLatest} />

    <div class="container">
      <!-- Inline ad -->
      <div class="ad-slot ad-slot-banner" style="margin: var(--space-2) 0 var(--space-8);">বিজ্ঞাপন</div>

      <!-- রাজনীতি + রাজধানী side by side -->
      <div class="dual-section">
        <CategorySection
          name="রাজনীতি"
          href="/category/politics"
          articles={politicsArticles}
          layout="featured-list"
        />
        <CategorySection
          name="রাজধানী"
          href="/category/capital"
          articles={capitalArticles}
          layout="featured-list"
        />
      </div>

      <!-- Inline ad -->
      <div class="ad-slot ad-slot-banner" style="margin: var(--space-4) 0;">বিজ্ঞাপন</div>
    </div>

    <!-- খেলা (Sports) — full width 4-column grid -->
    <div class="container">
      <CategorySection
        name="খেলা"
        href="/category/sports"
        articles={sportsArticles}
        layout="grid"
      />
    </div>

    <!-- ভিডিও section — dark bg -->
    <VideoSection videos={videos} />

    <!-- বাংলাদেশ section -->
    <div class="container">
      <CategorySection
        name="বাংলাদেশ"
        href="/category/bangladesh"
        articles={bangladeshArticles}
        layout="featured-list"
      />

      <!-- Inline ad -->
      <div class="ad-slot ad-slot-banner" style="margin: var(--space-2) 0 var(--space-4);">বিজ্ঞাপন</div>

      <!-- অর্থনীতি — 4-column grid -->
      <CategorySection
        name="অর্থনীতি"
        href="/category/economy"
        articles={economyArticles}
        layout="grid"
      />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
/* Side-by-side dual sections (রাজনীতি + রাজধানী) */
.dual-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(var(--grid-gap) * 2);
  margin-bottom: var(--space-6);
}
@media (max-width: 768px) {
  .dual-section { grid-template-columns: 1fr; }
}
</style>
