---
// src/layouts/AdminLayout.astro — Admin panel base layout
interface Props {
  title?: string;
  activeNav?: string;
}
const { title = 'Admin | সমকাল', activeNav = '' } = Astro.props;
const user = (Astro.locals as any).user;
---
<!DOCTYPE html>
<html lang="bn" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" />
</head>
<body class="admin-body">
  <div class="admin-layout">
    <!-- Sidebar nav -->
    <aside class="admin-sidebar">
      <div class="admin-sidebar__logo">
        <a href="/" class="admin-logo">
          <span class="admin-logo__main">সমকাল</span>
          <span class="admin-logo__sub">Admin</span>
        </a>
      </div>
      <nav class="admin-nav">
        <a href="/admin" class:list={['admin-nav__item', { active: activeNav === 'dashboard' }]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          ড্যাশবোর্ড
        </a>
        <a href="/admin/articles" class:list={['admin-nav__item', { active: activeNav === 'articles' }]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          সংবাদ তালিকা
        </a>
        <a href="/admin/articles/new" class:list={['admin-nav__item', { active: activeNav === 'new-article' }]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          নতুন সংবাদ
        </a>
        <a href="/admin/categories" class:list={['admin-nav__item', { active: activeNav === 'categories' }]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          বিভাগ
        </a>
        <a href="/admin/media" class:list={['admin-nav__item', { active: activeNav === 'media' }]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          মিডিয়া
        </a>
        <div class="admin-nav__divider"></div>
        <a href="/" class="admin-nav__item" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          সাইট দেখুন
        </a>
      </nav>
      <div class="admin-sidebar__footer">
        <div class="admin-user">
          <div class="admin-user__avatar">{user?.name?.[0] ?? 'A'}</div>
          <div class="admin-user__info">
            <div class="admin-user__name">{user?.name ?? 'Admin'}</div>
            <div class="admin-user__role">{user?.role ?? 'editor'}</div>
          </div>
        </div>
        <form action="/api/auth/logout" method="POST" style="margin-top: 8px;">
          <button type="submit" class="admin-logout-btn">লগ আউট</button>
        </form>
      </div>
    </aside>

    <!-- Main content -->
    <main class="admin-main">
      <slot />
    </main>
  </div>
</body>
</html>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --admin-sidebar-w: 240px;
  --admin-accent: #F9B200;
  --admin-bg: #F7F8FA;
  --admin-sidebar-bg: #1a1c23;
  --admin-sidebar-text: #C8CDD6;
  --admin-sidebar-active: #F9B200;
  --admin-border: #E5E7EB;
  --font: 'Inter', 'Noto Sans Bengali', sans-serif;
}

body.admin-body { font-family: var(--font); background: var(--admin-bg); color: #111; }

.admin-layout { display: flex; min-height: 100vh; }

/* Sidebar */
.admin-sidebar {
  width: var(--admin-sidebar-w);
  background: var(--admin-sidebar-bg);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; left: 0;
  height: 100vh;
  z-index: 100;
}

.admin-sidebar__logo {
  padding: 20px 20px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.admin-logo { text-decoration: none; display: flex; align-items: baseline; gap: 6px; }
.admin-logo__main { font-family: 'Noto Sans Bengali', sans-serif; font-size: 20px; font-weight: 800; color: var(--admin-accent); }
.admin-logo__sub { font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; }

.admin-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
.admin-nav__item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px;
  color: var(--admin-sidebar-text);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.15s;
  border-radius: 0;
}
.admin-nav__item:hover { background: rgba(255,255,255,0.06); color: #fff; }
.admin-nav__item.active { background: rgba(249,178,0,0.12); color: var(--admin-accent); border-right: 3px solid var(--admin-accent); }
.admin-nav__divider { height: 1px; background: rgba(255,255,255,0.08); margin: 8px 20px; }

.admin-sidebar__footer { padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.08); }
.admin-user { display: flex; align-items: center; gap: 10px; }
.admin-user__avatar {
  width: 32px; height: 32px;
  background: var(--admin-accent);
  color: #000;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 14px;
  flex-shrink: 0;
}
.admin-user__name { font-size: 13px; color: #fff; font-weight: 600; }
.admin-user__role { font-size: 11px; color: rgba(255,255,255,0.4); }
.admin-logout-btn {
  width: 100%;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.6);
  border: none;
  padding: 6px;
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
  font-family: var(--font);
  transition: all 0.15s;
}
.admin-logout-btn:hover { background: rgba(255,50,50,0.15); color: #ff6b6b; }

/* Main */
.admin-main {
  margin-left: var(--admin-sidebar-w);
  flex: 1;
  min-height: 100vh;
}
</style>
