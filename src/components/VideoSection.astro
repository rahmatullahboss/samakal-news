---
// src/components/VideoSection.astro
// Dark background video grid — replicates samakal's ভিডিও section
interface Video {
  title: string;
  href: string;
  thumbnail: string;
}
interface Props {
  videos: Video[];
}
const { videos } = Astro.props;
---

<section class="video-section">
  <div class="container">
    <div class="section-header" style="border-color: #444;">
      <h2 style="color: white;">ভিডিও</h2>
    </div>
    <div class="video-grid">
      {videos.map(v => (
        <a href={v.href} class="video-card">
          <div class="video-card__thumb">
            <img src={v.thumbnail} alt={v.title} loading="lazy" />
            <div class="video-card__play">
              <svg width="24" height="24" fill="white" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="12" fill="rgba(249,178,0,0.85)" />
                <polygon points="10,8 16,12 10,16" fill="white"/>
              </svg>
            </div>
          </div>
          <p class="video-card__title">{v.title}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.video-section {
  background: var(--color-bg-dark);
  padding: var(--space-8) 0;
  margin: var(--space-8) 0;
}
.video-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
}
.video-card { display: flex; flex-direction: column; gap: var(--space-2); }
.video-card__thumb {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  border-radius: var(--border-radius);
  background: #333;
}
.video-card__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
.video-card:hover .video-card__thumb img { transform: scale(1.05); }
.video-card__play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.85;
  transition: opacity var(--transition);
}
.video-card:hover .video-card__play { opacity: 1; }
.video-card__title {
  font-size: var(--text-sm);
  color: rgba(255,255,255,0.9);
  line-height: var(--leading-tight);
  font-family: var(--font-body);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 900px) { .video-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .video-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-3); } }
</style>
