---
// src/components/Header.astro
// Replicates samakal.com's top-bar + logo + horizontal nav menu
const categories = [
  { label: 'সর্বশেষ', href: '/category/latest' },
  { label: 'বাংলাদেশ', href: '/category/bangladesh' },
  { label: 'রাজনীতি', href: '/category/politics' },
  { label: 'অর্থনীতি', href: '/category/economy' },
  { label: 'বিশ্ব', href: '/category/world' },
  { label: 'খেলা', href: '/category/sports' },
  { label: 'বিনোদন', href: '/category/entertainment' },
  { label: 'সারাদেশ', href: '/category/nationwide' },
  { label: 'অপরাধ', href: '/category/crime' },
  { label: 'মতামত', href: '/category/opinion' },
  { label: 'রাজধানী', href: '/category/capital' },
  { label: 'লাইফস্টাইল', href: '/category/lifestyle' },
  { label: 'শৈলী', href: '/category/style' },
  { label: 'ভিডিও', href: '/category/video' },
];

// Today's date in Bangla format
const now = new Date();
const banglaDigits = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
const toBanglaNum = (n: number) => String(n).split('').map(d => banglaDigits[+d] || d).join('');
const banglaMonths = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
const banglaDays = ['রবিবার','সোমবার','মঙ্গলবার','বুধবার','বৃহস্পতিবার','শুক্রবার','শনিবার'];
const dateStr = `ঢাকা, ${banglaDays[now.getDay()]}, ${toBanglaNum(now.getDate())} ${banglaMonths[now.getMonth()]} ${toBanglaNum(now.getFullYear())}`;

const currentPath = Astro.url?.pathname ?? '/';
---

<header class="site-header">
  <!-- Top bar: date + social + epaper -->
  <div class="top-bar">
    <div class="container top-bar__inner">
      <span class="top-bar__date">{dateStr}</span>
      <div class="top-bar__right">
        <div class="top-bar__social">
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://x.com" target="_blank" rel="noopener" aria-label="X / Twitter">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="white" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          </a>
        </div>
        <a href="/epaper" class="top-bar__epaper">ই-পেপার</a>
        <a href="/en" class="top-bar__lang">English</a>
      </div>
    </div>
  </div>

  <!-- Logo bar -->
  <div class="logo-bar">
    <div class="container logo-bar__inner">
      <a href="/" class="logo" aria-label="সমকাল হোম">
        <span class="logo__text">সমকাল</span>
      </a>
      <!-- Top banner ad slot -->
      <div class="ad-slot ad-slot-banner logo-bar__ad">বিজ্ঞাপন</div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="main-nav" aria-label="প্রধান নেভিগেশন">
    <div class="container nav__inner">
      <ul class="nav__list">
        {categories.map(cat => (
          <li class="nav__item">
            <a
              href={cat.href}
              class:list={['nav__link', { 'nav__link--active': currentPath === cat.href }]}
            >
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
      <button class="nav__search" aria-label="অনুসন্ধান">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
/* ── Top bar ── */
.top-bar {
  background: var(--color-bg-alt);
  border-bottom: 1px solid var(--color-border);
  font-size: var(--text-xs);
}
.top-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 34px;
}
.top-bar__date { color: var(--color-text-secondary); }
.top-bar__right { display: flex; align-items: center; gap: var(--space-4); }
.top-bar__social { display: flex; gap: var(--space-3); }
.top-bar__social a {
  color: var(--color-text-secondary);
  display: flex;
  transition: color var(--transition);
}
.top-bar__social a:hover { color: var(--color-accent); }
.top-bar__epaper, .top-bar__lang {
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: color var(--transition);
}
.top-bar__epaper:hover, .top-bar__lang:hover { color: var(--color-text); }

/* ── Logo bar ── */
.logo-bar {
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
}
.logo-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
}
.logo { display: flex; align-items: center; flex-shrink: 0; }
.logo__text {
  font-family: var(--font-headline);
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -0.02em;
  line-height: 1;
}
.logo-bar__ad { flex: 1; max-width: 728px; height: 90px; }

/* ── Main nav ── */
.main-nav {
  background: var(--color-bg);
  border-bottom: 2px solid var(--color-accent);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}
.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}
.nav__list {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}
.nav__link {
  display: block;
  padding: var(--space-3) var(--space-3);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text);
  white-space: nowrap;
  transition: background var(--transition), color var(--transition);
  border-bottom: 3px solid transparent;
}
.nav__link:hover,
.nav__link--active {
  color: var(--color-text);
  border-bottom-color: var(--color-accent);
  background: rgba(249,178,0,0.07);
}
.nav__search {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text);
  padding: var(--space-2);
  display: flex;
  transition: color var(--transition);
  flex-shrink: 0;
}
.nav__search:hover { color: var(--color-accent); }

/* Responsive */
@media (max-width: 768px) {
  .logo__text { font-size: 2rem; }
  .logo-bar__ad { display: none; }
  .nav__link { padding: var(--space-2) var(--space-2); font-size: var(--text-xs); }
}
</style>
